pipeline {

    agent {
        label 'Worker-node'
    }

    stages {

        stage('Clone') {
            steps {
                git url: 'https://github.com/arbajmangaonkar191/Devops_Tracker.git',
                    branch: 'master'
            }
        }

        stage('Build') {
            steps {
                sh 'docker compose build'
            }
        }

        stage('Deploy') {
            steps {
                sh 'docker compose up -d'
            }
        }
    }
}
